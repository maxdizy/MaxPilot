classdef XPlaneStateReader < matlab.System
    % Reads X-Plane 12 aircraft state using the Web API
    % Output: [u v w p q r phi theta psi North East alt]

    properties (Access = private)
        URL

        lat0
        lon0
        
        latID
        lonID
        altID
        phiID
        thetaID
        psiID
        pID
        qID
        rID
        uID
        vID
        wID

        R = 6378137;
    end

    methods (Access = protected)
        function setupImpl(obj)
            obj.URL = "http://127.0.0.1:8086/api/v3";
            obj.lat0 = obj.getDREF("sim/flightmodel/position/latitude");
            obj.lon0 = obj.getDREF("sim/flightmodel/position/longitude");

            obj.latID = obj.getID("sim/flightmodel/position/latitude");
            obj.lonID = obj.getID("sim/flightmodel/position/longitude");
            obj.altID = obj.getID("sim/flightmodel/position/elevation");

            obj.phiID = obj.getID("sim/flightmodel/position/phi");
            obj.thetaID = obj.getID("sim/flightmodel/position/theta");
            obj.psiID = obj.getID("sim/flightmodel/position/psi");

            obj.pID = obj.getID("sim/flightmodel/position/P");
            obj.qID = obj.getID("sim/flightmodel/position/Q");
            obj.rID = obj.getID("sim/flightmodel/position/R");

            obj.uID = obj.getID("sim/flightmodel/position/local_vx");
            obj.vID = obj.getID("sim/flightmodel/position/local_vy");
            obj.wID = obj.getID("sim/flightmodel/position/local_vz");
        end

        function state = stepImpl(obj)
            lat = obj.getDREF("sim/flightmodel/position/latitude");
            lon = obj.getDREF("sim/flightmodel/position/longitude");
            alt = obj.getDREF("sim/flightmodel/position/elevation");

            lat0_rad = deg2rad(obj.lat0);
            lon0_rad = deg2rad(obj.lon0);
            lat_rad = deg2rad(lat);
            lon_rad = deg2rad(lon);

            North = obj.R*(lat_rad-lat0_rad);
            East = obj.R*cos(lat0_rad)*(lon_rad-lon0_rad);

            phi = obj.getDREF("sim/flightmodel/position/phi");
            theta = obj.getDREF("sim/flightmodel/position/theta");
            psi = obj.getDREF("sim/flightmodel/position/psi");

            p = obj.getDREF("sim/flightmodel/position/P");
            q = obj.getDREF("sim/flightmodel/position/Q");
            r = obj.getDREF("sim/flightmodel/position/R");

            u = obj.getDREF("sim/flightmodel/position/local_vx");
            v = obj.getDREF("sim/flightmodel/position/local_vy");
            w = obj.getDREF("sim/flightmodel/position/local_vz");

            state = [
                u;
                v;
                w;
                p;
                q;
                r;
                phi;
                theta;
                psi;
                North;
                East;
                alt
            ];
        end

        function resetImpl(obj)
            obj.lat0 = 0;
            obj.lon0 = 0;
        end

    end

    methods (Access = private)
        function id = getID(obj, name)
            coder.extrinsic('webread');
            id = 0;
            result = webread(obj.URL + "/datarefs", "filter[name]", name);
            if isstruct(result)
                id = result.data(1).id;
            end
        end

        function value = getDREF(obj,id)
            coder.extrinsic('webread');
            % coder.extrinsic('weboptions');
            % options = weboptions("ContentType","json");
            result = webread(obj.URL + "/datarefs/" + string(id) + "/value");
            if isstruct(result)
                value = result.data.value;
            end
        end
    end

    methods (Access = protected)
        function out = getOutputSizeImpl(~)
            out = [12 1];
        end

        function out = getOutputDataTypeImpl(~)
            out = "double";
        end

        function out = isOutputComplexImpl(~)
            out = false;
        end

        function out = isOutputFixedSizeImpl(~)
            out = true;
        end

    end
end